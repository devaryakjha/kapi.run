{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kapi-run",
  "main": "./apps/worker/src/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "kapi.run",
      "custom_domain": true
    }
  ],
  "vars": {
    "KAPI_WEB_URL": "https://kapi.run",
    "SWIGGY_REDIRECT_URI": "https://kapi.run/auth/callback"
  },
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/health",
      "/auth/*",
      "/food/*",
      "/relay/*",
      "/new",
      "/join",
      "/menu",
      "/review"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "KAPI_API",
        "class_name": "KapiApi"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["KapiApi"]
    }
  ],
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
